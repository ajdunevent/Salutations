{
    "id": "net.dunevent.Salutations",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command": "salutations",
    "finish-args": [
        "--share=network",
        "--share=ipc",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--device=dri",
        "--talk-name=org.gnome.evolution.dataserver.Sources5",
        "--talk-name=org.gnome.evolution.dataserver.AddressBook10",
        "--filesystem=~/.gnupg",
        "--talk-name=org.gnome.keyring.SystemPrompter",
        "--socket=pcsc",
        "--talk-name=org.gnome.OnlineAccounts",
        "--talk-name=org.freedesktop.secrets",
        "--talk-name=org.freedesktop.Notifications",
        "--talk-name=org.gnome.Settings",
        "--talk-name=org.gnome.Contacts.SearchProvider",
        "--filesystem=xdg-cache/evolution/addressbook:ro",
        "--talk-name=com.canonical.Unity",
        "--system-talk-name=org.freedesktop.login1"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/lib/cmake",
        "/share/pkgconfig",
        "/share/gtk-doc",
        "/share/man",
        "/share/GConf",
        "*.la",
        "*.a",
        "/share/applications/org.gnome.*",
        "/share/icons/hicolor/symbolic/apps/org.gnome.goa-daemon-symbolic.svg"
    ],
    "modules": [
        {
            "name": "libical",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=Release",
                "-DCMAKE_INSTALL_LIBDIR=lib",
                "-DICAL_GLIB=ON",
                "-DICAL_GLIB_VAPI=OFF",
                "-DGOBJECT_INTROSPECTION=OFF",
                "-DICAL_BUILD_DOCS=OFF",
                "-DLIBICAL_BUILD_TESTING=OFF",
                "-DWITH_CXX_BINDINGS=OFF",
                "-DSHARED_ONLY=ON"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/libical/libical/releases/download/v3.0.20/libical-3.0.20.tar.gz",
                    "sha256": "e73de92f5a6ce84c1b00306446b290a2b08cdf0a80988eca0a2c9d5c3510b4c2"
                }
            ]
        },
        {
            "name": "gnome-online-accounts",
            "buildsystem": "meson",
            "config-opts": [
                "--libdir=lib",
                "-Dgoabackend=false",
                "-Ddocumentation=false",
                "-Dintrospection=false",
                "-Dman=false",
                "-Dvapi=false"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/gnome-online-accounts/3.58/gnome-online-accounts-3.58.1.tar.xz",
                    "sha256": "9ec1900cc51409c2067c07c828c10be06fe3bf68d2999bb72d7d5ed325ed9bbc"
                }
            ]
        },
        {
            "name": "evolution-data-server",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=Release",
                "-DLIB_INSTALL_DIR=/app/lib",
                "-DENABLE_GTK=OFF",
                "-DENABLE_GTK4=OFF",
                "-DENABLE_OAUTH2_WEBKITGTK=OFF",
                "-DENABLE_OAUTH2_WEBKITGTK4=OFF",
                "-DENABLE_EXAMPLES=OFF",
                "-DENABLE_GOA=ON",
                "-DENABLE_WEATHER=OFF",
                "-DENABLE_CANBERRA=OFF",
                "-DENABLE_TESTS=OFF",
                "-DENABLE_INTROSPECTION=OFF",
                "-DENABLE_VALA_BINDINGS=OFF",
                "-DENABLE_GTK_DOC=OFF",
                "-DWITH_LIBDB=OFF",
                "-DWITH_OPENLDAP=OFF",
                "-DWITH_PHONENUMBER=OFF",
                "-DWITH_KRB5=OFF",
                "-DWITH_SYSTEMDUSERUNITDIR=OFF",
                "-DWITH_DBUS_SERVICE_DIR=/app/share/dbus-1/services"
            ],
            "cleanup": [
                "/libexec",
                "/share/dbus-1",
                "/lib/evolution-data-server/addressbook-backends",
                "/lib/evolution-data-server/calendar-backends",
                "/lib/evolution-data-server/registry-modules"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/evolution-data-server/3.60/evolution-data-server-3.60.2.tar.xz",
                    "sha256": "2084dbdac396371b365d504c1ff45866ba8dca2f1252e5da1d3d9c33abdc1286"
                }
            ]
        },
        {
            "name": "libspelling",
            "buildsystem": "meson",
            "config-opts": [
                "--libdir=lib",
                "-Ddocs=false",
                "-Dintrospection=disabled",
                "-Dvapi=false",
                "-Dsysprof=false"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/libspelling/0.4/libspelling-0.4.11.tar.xz",
                    "sha256": "52e53ec3fba0f604cfd0931e26af7f7241a0d4f0208dd5574f43b3589f6d28b2"
                }
            ]
        },
        {
            "name": "salutations",
            "buildsystem": "simple",
            "build-options": {
                "append-path": "/usr/lib/sdk/rust-stable/bin",
                "env": {
                    "CARGO_HOME": "/run/build/salutations/cargo"
                }
            },
            "build-commands": [
                "cargo --offline build --release -p salutations",
                "install -Dm755 target/release/salutations /app/bin/salutations",
                "install -Dm644 salutations/data/net.dunevent.Salutations.desktop /app/share/applications/net.dunevent.Salutations.desktop",
                "install -Dm644 salutations/data/net.dunevent.Salutations.metainfo.xml /app/share/metainfo/net.dunevent.Salutations.metainfo.xml",
                "install -Dm644 salutations/data/icons/scalable/apps/net.dunevent.Salutations.svg /app/share/icons/hicolor/scalable/apps/net.dunevent.Salutations.svg",
                "install -Dm644 salutations/data/icons/symbolic/apps/net.dunevent.Salutations-symbolic.svg /app/share/icons/hicolor/symbolic/apps/net.dunevent.Salutations-symbolic.svg"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "..",
                    "skip": [
                        "target",
                        ".flatpak-builder",
                        "build-dir",
                        "repo",
                        "build-aux",
                        "screenshots"
                    ]
                },
                "cargo-sources.json"
            ]
        }
    ]
}
